# =============================================================================
# HelpBotV0 environment variables
# =============================================================================
# HOW TO USE:
#   1. Copy this file to `.env`  ->  `cp .env.example .env`
#   2. Fill in real values from Anthropic, OpenAI, and Supabase dashboards.
#   3. NEVER commit `.env` (it is in .gitignore).
#   4. For production: paste these same values into Netlify
#      Site settings -> Environment variables.
#
# Rule of thumb:
#   - Anything that starts with VITE_ is EXPOSED to the browser. Public-safe only.
#   - Everything else is SERVER-ONLY (used by Netlify Functions). Treat as secrets.
# =============================================================================


# --- SERVER-ONLY SECRETS (Netlify Functions read these) ------------------------

# Anthropic Claude API key — required for the bot to reply.
# Get it from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# OpenAI API key — leave blank for now. Wired up but stubbed.
# Get it from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Which model to use by default for Claude (override at any time).
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Supabase service-role key. SERVER ONLY. Never put this in the browser.
# Get it from your Supabase project -> Project settings -> API -> service_role.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJREPLACE_ME

# Optional: hard cost guardrail. Max tokens Claude is allowed to generate per reply.
MAX_OUTPUT_TOKENS=1024

# Optional: rate limit knobs.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=20


# --- PUBLIC (browser-safe) VARIABLES -------------------------------------------
# These are baked into the frontend bundle. ONLY put values here that are safe
# to be public. The Supabase anon key IS designed to be public, as long as
# Row Level Security (RLS) is enabled on every table.

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJREPLACE_ME
